;; Default config definition to suppress warning when it is missing.
(defcfg
  process-unmapped-keys no
)

;; Config for 12" MacBook with physical f keys. This config allows for brightness etc to still work.
(defsrc
  esc   f1   f2   f3   f4   f5     f6    f7    f8    f9    f10   f11   f12
  grv   1    2    3    4    5       6    7    8    9    0       -    =    bspc
  tab   q    w    e    r    t       y    u    i    o    p       [    ]    ret
  caps  a    s    d    f    g       h    j    k    l    ;       '    \
  lsft  z    x    c    v    b       n    m    ,    .    /       rsft
  lctl  lalt lmet          spc            rmet ralt
)

(defvar
  ;; Note: consider using different time values for your different fingers.
  ;; For example, your pinkies might be slower to release keys and index
  ;; fingers faster.
  tap-time 200
  hold-time 200
  hold-time-slow 300
)

(defalias
  meh  (multi lctl lalt lsft)
  th_meh (tap-hold $tap-time $hold-time spc @meh)

  layerSym (layer-toggle symbols)
  layerNum (layer-toggle num)

  a (tap-hold $tap-time $hold-time a lctl)
  d (tap-hold $tap-time $hold-time d lctl)
  f (tap-hold $tap-time $hold-time f @layerNum)
  ; (tap-hold $tap-time $hold-time ; S-;) ;; hold for :
  = (tap-hold $tap-time $hold-time = S-=) ;; hold for +
  - (tap-hold $tap-time $hold-time - S--) ;; hold for _
  s (tap-hold $tap-time $hold-time-slow s @layerSym)
  v (tap-hold $tap-time $hold-time v @layerNum)
  m (tap-hold $tap-time $hold-time m @layerNum)
  z (tap-hold $tap-time $hold-time z @layerSym)
  / (tap-hold $tap-time $hold-time / @layerSym)

  cj (chord rnums j)
  ck (chord rnums k)
  cf (chord lnums f)
  cd (chord lnums d)
)

(defchords rnums 20
  (j  ) j
  (  k) k
  (j k) @layerNum
)

(defchords lnums 20
  (d  ) @d
  (  f) @f
  (d f) @layerNum

)

(deflayer main
  esc    🔅   🔆   XX   XX   XX      XX   ◀◀   ▶⏸    ▶▶    🔇    🔉    🔊
  grv    1    2    3    4    5       6    7    8    9    0       @-   @=    bspc
  tab    q    w    e    r    t       y    u    i    o    p       [    ]     ret
  esc    @a   @s   @cd  @cf  g       h    @cj  @ck  l    @;      '    \
  lsft   @z   x    c    @v   b       n    @m    ,    .   @/       rsft
  lctl   lalt lmet          @th_meh            rmet ralt
)

(deflayer symbols
  esc    🔅    🔆   XX    XX     XX       XX    ◀◀    ▶⏸    ▶▶    🔇    🔉    🔊
  XX     XX    XX   XX    XX     XX       XX    XX    XX    XX    XX     -    @=    bspc
  S-grv  S-1   S-2    S-3     S-4      S-5   S-6   S-7   S-8   S-9    S-0    S--   S-=    bspc
  XX     XX    XX   XX    XX     XX     left  down   up  right    @-     @=    XX
  XX     XX    XX   XX    XX     XX     S-[  S-]    [    ]    XX     XX
  XX     XX    XX         spc             XX    XX
)

(deflayer num
  esc    🔅    🔆   XX     XX     XX       XX    ◀◀    ▶⏸    ▶▶    🔇    🔉    🔊
  XX     XX    XX   XX     XX     XX       XX    XX    XX    XX    XX     -    XX    bspc
  grv     1    2    3      4       5        6    7     8     9     0      @-   @=    XX
  XX     XX    XX   XX     XX     XX       XX    4     5     6     .     XX    XX
  XX     XX    XX   C-c    XX     XX     lsft    1     2     3     XX    XX
  XX     XX    XX          spc             XX    XX
)
